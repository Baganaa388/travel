# ── Сервер ────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# Хуудас өгөх лавлах. Production-д build хийсний дараа: dist
SERVE_DIR=public

# ── Аюулгүй байдал ────────────────────────────────────────────────────────
# Урт санамсаргүй утга. Үүсгэх:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Анхны admin хэрэглэгч (эхний db:seed үед үүснэ).
# АНХААР: нууц үгэнд # эсвэл хоосон зай байвал ЗААВАЛ хашилтанд бич,
# эс бөгөөс dotenv #-ээс хойшхийг тайрна.  Ж: ADMIN_PASSWORD="Aa1#strong"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Cookie-г зөвхөн HTTPS-ээр явуулах эсэх (production-д 1 байх ёстой)
COOKIE_SECURE=0


# Сайтын нийтийн хаяг (мэдэгдэлд холбоос үүсгэхэд)
PUBLIC_URL=http://localhost:8000
