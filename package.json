{
  "name": "dreamspark-travel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dream Spark Travel Agency — Монголын нутгийн аялалын компанийн олон хэлт (MN/EN/KR) динамик вэбсайт",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "node scripts/build.mjs",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:reset": "node server/db/migrate.js --reset && node server/db/seed.js",
    "db:admin": "node server/db/reset-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,mjs,css,html,json,md}\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "multer": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "sharp": "^0.35.4"
  }
}
